# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/*).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET / LEARNOS_TOKEN_SECRET: HMAC-SHA256 secret used for signing backend session tokens.
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# APP_URL: Public HTTPS URL where Specialized Study is hosted (e.g., https://your-app.vercel.app).
APP_URL="https://specialized-study.vercel.app"

# Firebase Web App Configuration (Project: specialized-study)
