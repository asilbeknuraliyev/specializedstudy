VITE_FIREBASE_PROJECT_ID="specialized-study"
VITE_FIREBASE_APP_ID="1:848511288912:web:df85c4a28ff91cb3887355"
VITE_FIREBASE_STORAGE_BUCKET="specialized-study.firebasestorage.app"
