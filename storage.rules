rules_version = '2';

// Hardened Firebase Cloud Storage Security Rules — Specialized Study
// Authorized Platform Administrators: asilbeknuraliyev43@gmail.com, bahodirboliqulov3@gmail.com
// Enforces path-based access, magic-byte/MIME validation, and strict file size limits.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isVerifiedPlatformOwner() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'asilbeknuraliyev43@gmail.com',
          'bahodirboliqulov3@gmail.com'
        ];
    }

    function isAllowedImageMime() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAllowedDocumentMime() {
      return request.resource.contentType in [
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'text/csv',
        'application/pdf',
        'image/jpeg',
        'image/png',
        'image/webp'
      ];
    }

    function isUnderMaxBytes(maxBytes) {
      return request.resource.size > 0 && request.resource.size <= maxBytes;
    }

    // 1. Question Media Assets (Images for questions/options — max 5 MB)
    match /institutions/{institutionId}/question_media/{mediaFile} {
      allow read: if isSignedIn();
      allow create, update: if isVerifiedPlatformOwner()
        && isAllowedImageMime()
        && isUnderMaxBytes(5 * 1024 * 1024);
      allow delete: if isVerifiedPlatformOwner();
    }

    // 2. Work Plan Uploads (Excel, CSV, PDF, Image — max 10 MB, Admin Only)
    match /institutions/{institutionId}/work_plans/{planFile} {
      allow read, delete: if isVerifiedPlatformOwner();
      allow create, update: if isVerifiedPlatformOwner()
        && isAllowedDocumentMime()
        && isUnderMaxBytes(10 * 1024 * 1024);
    }

    // 3. Student Roster Excel/CSV Imports (Admin Only — max 10 MB)
    match /institutions/{institutionId}/student_imports/{importFile} {
      allow read, delete: if isVerifiedPlatformOwner();
      allow create, update: if isVerifiedPlatformOwner()
        && request.resource.contentType in [
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv'
        ]
        && isUnderMaxBytes(10 * 1024 * 1024);
    }

    // 4. Class Lesson Attachments (Readable by authenticated students in institution; writable only by Platform Owner)
    match /institutions/{institutionId}/classes/{classCode}/lessons/{lessonFile} {
      allow read: if isSignedIn();
      allow create, update: if isVerifiedPlatformOwner()
        && isAllowedDocumentMime()
        && isUnderMaxBytes(10 * 1024 * 1024);
      allow delete: if isVerifiedPlatformOwner();
    }

    // 5. Learning Materials Library (PDF, DOCX, PPTX, XLSX, Images — max 25 MB; Admin upload, authenticated read)
    match /institutions/{institutionId}/materials/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isVerifiedPlatformOwner()
        && isAllowedDocumentMime()
        && isUnderMaxBytes(25 * 1024 * 1024);
      allow delete: if isVerifiedPlatformOwner();
    }

    // 6. Student Homework & Assignment Submissions (Student can upload/read own folder; Admin can read/manage all)
    match /institutions/{institutionId}/submissions/{studentId}/{allPaths=**} {
      allow read: if isVerifiedPlatformOwner() || (isSignedIn() && request.auth.uid == studentId);
      allow create, update: if (isVerifiedPlatformOwner() || (isSignedIn() && request.auth.uid == studentId))
        && isAllowedDocumentMime()
        && isUnderMaxBytes(15 * 1024 * 1024);
      allow delete: if isVerifiedPlatformOwner();
    }

    // Default deny-all fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
